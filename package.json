{
  "name": "ultra-rotina-backend",
  "version": "2.5.0",
  "description": "Backend de alta performance para o Assistente Clínico Ultra Rotina e Cockpit PWA",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "node --check server.js && node --check server/index.js && node --check server/runtime.js && node --check server/validators.js",
    "test": "node scripts/run_tests.cjs",
    "build": "python3 build_master.py",
    "extrair:hsl": "node scripts/extrair_guia_hsl.js",
    "test:all": "node scripts/run_tests.cjs --all",
    "test:autoloop": "python3 -m pytest tooling/autoloop/tests -q"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@google/genai": "^2.28.0",
    "fastify": "^5.2.1",
    "pdfkit": "^0.20.2",
    "sync-fetch": "^0.5.2",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "ISC"
}
